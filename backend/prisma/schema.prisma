generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
  STORE_OWNER
}

model User {
  id           String    @id @default(uuid())
  name         String
  email        String    @unique
  passwordHash String
  address      String
  role         Role      @default(USER)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // A Store Owner can own a store
  ownedStore   Store?    @relation("StoreToOwner")
  
  // Normal Users submit ratings
  ratings      Rating[]

  @@index([email])
  @@index([role])
}

model Store {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  address   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Store owner relationship
  ownerId   String?  @unique
  owner     User?    @relation("StoreToOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  // Store ratings
  ratings   Rating[]

  @@index([name])
  @@index([email])
}

model Rating {
  id        String   @id @default(uuid())
  score     Int
  userId    String
  storeId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([userId, storeId])
  @@index([storeId])
  @@index([userId])
}
